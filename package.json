{
  "name": "mobile-tty",
  "version": "0.1.0",
  "description": "TUI-friendly mobile web terminal",
  "scripts": {
    "test": "node --test 'tests/unit/**/*.test.js'",
    "test:integrity": "node --test 'tests/integrity/*.test.js'",
    "test:real-pi": "node --test 'tests/real-pi/*.test.js'",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test -c playwright.smoke.config.js",
    "typecheck": "tsc --noEmit",
    "postinstall": "chmod +x node_modules/node-pty/prebuilds/*/spawn-helper 2>/dev/null || true"
  },
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@wterm/core": "0.3.4",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "esbuild": "^0.28.2",
    "node-pty": "1.1.0",
    "ws": "^8.21.3"
  }
}
