#!/bin/bash
# The entry point. Everything here runs in the foreground and owns what it
# starts. The server holds every session it has been asked to join, in the
# background, until it is stopped: ending the server (Ctrl-C here) ends all
# of them at once, but nothing in front of it does.
set -euo pipefail

# Resolve through symlinks so ~/bin/mobile-tty -> repo/mobile-tty still finds
# server/, scripts/ and cloudflared.yml.
self=$0
while [[ -L "$self" ]]; do
  self_dir=$(cd -P "$(dirname "$self")" && pwd)
  self=$(readlink "$self")
  [[ "$self" == /* ]] || self=$self_dir/$self
done
root=$(cd -P "$(dirname "$self")" && pwd)
cd "$root" || { echo "mobile-tty: cannot enter $root" >&2; exit 1; }
[[ -f server/cli.js ]] || { echo "mobile-tty: $root does not look like the mobile-tty checkout" >&2; exit 1; }

port="${MTTY_PORT:-7681}"
bind="${MTTY_BIND:-127.0.0.1}"
# The one hostname a proxy in front of this may present. Only needed when you
# reach it by name rather than by address; see --hostname in the usage.
hostname="${MTTY_HOSTNAME:-}"
theme="${MTTY_THEME:-dark}"
newdir="${MTTY_NEW_DIR:-}"
with_tunnel=""
config="$PWD/cloudflared.yml"

default_program=(pi)

usage() {
  cat <<'USAGE'
Usage: mobile-tty [command] [options] [program...]

  sessions       list sessions on the server (default)
  end [fragment] end a running session
  serve          serve the terminal
  attach         attach this terminal to a running server
  tunnel         run the Cloudflare tunnel on its own
  setup <host>   create the tunnel, DNS and Access login for a hostname

Options

  --lan          short for --bind 0.0.0.0
  --bind ADDR    listen on one address (default 127.0.0.1, or $MTTY_BIND)
  --port N       default 7681, or $MTTY_PORT
  --hostname NAME the name a proxy in front of this presents, e.g. the
                 Cloudflare or tailnet hostname (or $MTTY_HOSTNAME)
  --theme NAME   dark (default) or light; the menu can also switch per-device
  --new-dir DIR  where the phone's "new session" starts (default: this folder,
                 or $MTTY_NEW_DIR)
  --tunnel       run the Cloudflare tunnel alongside the server
  --yes          skip the confirmation when ending a session

Loopback is the default because the tunnel reaches it from this machine. Use
--lan to reach it from a phone on the same wifi, which puts an unauthenticated
terminal on your network.

Joining a session spawns it in the background if it is not already running,
and leaves it running when you look away — the phone, a browser tab and any
number of `attach`ed terminals can each be looking at a different one at the
same time, the way running pi a few times in different terminals would be.
Whichever session a viewer is looking at, the narrowest viewer of that one
decides its size, because this is meant to be read on a phone.
`attach [name-or-path]` joins a server that is already running; it does not
start one, and prompts if more than one session matches. `sessions` lists the
running ones, and `end [fragment]` stops a running session after confirmation;
`--yes` skips that confirmation. Exiting the program in a session also ends it,
and Ctrl-C in the terminal serving all of them ends every session at once.

The menu offers every session pi has a transcript for, newest first, whether
or not it is currently running.

Set $MTTY_PASSWORD for a login page and a cookie: an opt-in alternative to
Access for a network you already trust. Not a flag, because a command line is
readable by every process on the machine, and not basic auth, because Safari
sends no such header on a WebSocket handshake and the terminal would never
connect. Use `setup` and let Cloudflare Access do it instead when it is facing
the internet.

A page on any site you visit can open a WebSocket to this server, so sockets
are refused unless their Origin matches the address they connected to. Reaching
it by address needs nothing; reaching it by name needs that name in --hostname.
USAGE
}

die() { echo "mobile-tty: $*" >&2; exit 1; }
usage_error() { echo "mobile-tty: $*" >&2; exit 2; }

cmd=""
yes=0
end_match=""

# Options can come either side of the command; serve's first non-option is the
# program, while end captures one fragment and can still read options after it.
take_options() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --lan) bind=0.0.0.0; shift ;;
      --bind) [[ $# -ge 2 ]] || usage_error "--bind needs a value"; bind=$2; shift 2 ;;
      --port) [[ $# -ge 2 ]] || usage_error "--port needs a value"; port=$2; shift 2 ;;
      --hostname) [[ $# -ge 2 ]] || usage_error "--hostname needs a value"; hostname=$2; shift 2 ;;
      --theme) [[ $# -ge 2 ]] || usage_error "--theme needs a value"; theme=$2; shift 2 ;;
      --new-dir) [[ $# -ge 2 ]] || usage_error "--new-dir needs a value"; newdir=$2; shift 2 ;;
      --tunnel) with_tunnel=1; shift ;;
      --yes) yes=1; shift ;;
      -h|--help|help) usage; exit 0 ;;
      --) shift; break ;;
      -*) usage_error "unknown option $1" ;;
      serve|sessions|end|attach|tunnel|setup)
        [[ -z "$cmd" ]] || break        # a second one is the program's business
        cmd=$1; shift ;;
      *)
        if [[ "$cmd" == end && -z "$end_match" ]]; then
          end_match=$1; shift
        else
          break
        fi ;;
    esac
  done
  REST=("$@")
}

REST=()
take_options "$@"
set -- ${REST[@]+"${REST[@]}"}
[[ -n "$cmd" ]] || cmd=sessions

# setup takes a hostname, not our options, but it should still hear the port so
# the tunnel it writes points at the right place.
[[ "$cmd" == setup ]] && exec env MTTY_PORT="$port" scripts/cf-access.sh "$@"

# Follows --bind: node resolves `localhost` to ::1 on a machine that prefers
# IPv6, so a URL pinned to 127.0.0.1 would never find a server that bound by
# name. An IPv6 literal needs brackets to go in one.
case "$bind" in *:*) host="[$bind]" ;; *) host=$bind ;; esac

# Empty unless a name was given, so the flag is absent rather than blank.
host_args=()
[[ -n "$hostname" ]] && host_args=(--hostname "$hostname")

case "$cmd" in
  serve)
    [[ $# -gt 0 ]] || set -- "${default_program[@]}"

    # Without a tunnel this shell has nothing to supervise, so it gets out of
    # the way rather than sitting between you and the server.
    if [[ -z "$with_tunnel" ]]; then
      echo "serving http://$bind:$port"
      exec node server/cli.js --port "$port" --bind "$bind" --theme "$theme" \
        ${newdir:+--new-dir "$newdir"} \
        ${host_args[@]+"${host_args[@]}"} -- "$@"
    fi

    [[ -f "$config" ]] || die "no $config -- run: mobile-tty setup <hostname>"
    # A proxy in front means the Origin check needs its name; without one the
    # page loads and the terminal silently never connects.
    [[ -n "$hostname" ]] ||
      echo "mobile-tty: WARNING: --tunnel without --hostname; the terminal will not connect" >&2
    # The edge answers this whether or not the tunnel is running, so it can be
    # asked before starting. It is the only thing about this setup you cannot
    # see from this machine.
    host=$(sed -n 's/^ *- hostname: *//p' "$config" | head -1)
    probe=$(curl -s -o /dev/null -w '%{http_code} %{redirect_url}' --max-time 8 "https://$host/" 2>/dev/null || echo '000 ')
    case "${probe%% *}" in
      30*) [[ "${probe#* }" == *cloudflareaccess.com* ]] &&
             echo "$host is behind a login" ||
             echo "$host redirects somewhere that is not Access -- check the application" ;;
      200) echo "WARNING: $host answers with no login in front of it" ;;
      *) echo "$host is not answering yet (${probe%% *})" ;;
    esac

    # Installed before anything starts: an interrupt part-way through would
    # otherwise leave a tunnel or a server with nothing watching it. Both are
    # unset until their own line runs, so the trap has to tolerate that.
    trap 'kill ${tunnel:-} ${server:-} 2>/dev/null || true' EXIT INT TERM

    cloudflared tunnel --config "$config" run &
    tunnel=$!

    echo "serving http://$bind:$port"
    # In the background, then waited on. Not exec, which would replace this
    # shell and take the trap with it; and not the foreground either, because
    # bash defers signals until the foreground command returns -- so a TERM
    # would sit unhandled and leave the tunnel behind.
    node server/cli.js --port "$port" --bind "$bind" --theme "$theme" \
      ${newdir:+--new-dir "$newdir"} \
      ${host_args[@]+"${host_args[@]}"} -- "$@" &
    server=$!

    status=0
    wait $server || status=$?
    [[ $status -eq 0 ]] || echo "mobile-tty: the server exited ($status); stopping the tunnel too" >&2
    exit $status
    ;;
  sessions)
    [[ $# -eq 0 ]] || usage_error "sessions takes no arguments"
    exec env node -e "import('./server/control.js').then(m => m.sessions('ws://$host:$port'))"
    ;;
  end)
    [[ $# -eq 0 ]] || usage_error "end takes at most one session fragment"
    exec env MTTY_END_MATCH="$end_match" MTTY_YES="$yes" node -e \
      "import('./server/control.js').then(m => m.end('ws://$host:$port', { match: process.env.MTTY_END_MATCH || undefined, yes: process.env.MTTY_YES === '1' }))"
    ;;
  attach)
    # An optional name or path fragment picks which of the server's sessions to
    # join, the same way the phone's own menu lists them; bare `attach` prompts
    # when more than one matches. Passed through the environment, not baked
    # into the -e source below, since it is arbitrary text you typed.
    exec env MTTY_ATTACH_MATCH="${1:-}" node -e \
      "import('./server/attach.js').then(m => m.attach({ url: 'ws://$host:$port/ws', match: process.env.MTTY_ATTACH_MATCH || undefined }))"
    ;;
  tunnel)
    [[ -f "$config" ]] || die "no $config -- run: mobile-tty setup <hostname>"
    exec cloudflared tunnel --config "$config" run
    ;;
esac
