#!/bin/bash
# The entry point. Everything here runs in the foreground and owns what it
# starts, and the server owns the program: ending the server ends the session,
# so there is no state left between invocations at all.
set -euo pipefail

# Resolve through symlinks so ~/bin/mobile-tty -> repo/mobile-tty still finds
# server/, scripts/ and cloudflared.yml.
self=$0
while [[ -L "$self" ]]; do
  self_dir=$(cd -P "$(dirname "$self")" && pwd)
  self=$(readlink "$self")
  [[ "$self" == /* ]] || self=$self_dir/$self
done
root=$(cd -P "$(dirname "$self")" && pwd)
cd "$root" || { echo "mobile-tty: cannot enter $root" >&2; exit 1; }
[[ -f server/cli.js ]] || { echo "mobile-tty: $root does not look like the mobile-tty checkout" >&2; exit 1; }

port="${PORT:-7681}"
# Lines of history a reconnecting viewer gets back. pi does not page its own
# transcript, so this is the only way to read back through a conversation.
scrollback="${MTTY_SCROLLBACK:-500}"
bind="${MTTY_BIND:-127.0.0.1}"
# The one hostname a proxy in front of this may present. Only needed when you
# reach it by name rather than by address; see --hostname in the usage.
hostname="${MTTY_HOSTNAME:-}"
config="$PWD/cloudflared.yml"

# A restart kills the program, so the default one is told to come back to the
# same conversation. Without --session-id plain pi would start a fresh session
# every time the server bounced.
default_program=(pi --session-id mobile-tty)

usage() {
  cat <<'USAGE'
Usage: mobile-tty [command] [options] [program...]

  serve          serve the terminal (default)
  attach         attach this terminal to a running server
  up             serve and run the tunnel, both ending together
  tunnel         run the Cloudflare tunnel on its own
  setup <host>   create the tunnel, DNS and Access login for a hostname
  down           end everything, including the program and its history

Options

  --lan          short for --bind 0.0.0.0
  --bind ADDR    listen on one address (default 127.0.0.1, or $MTTY_BIND)
  --port N       default 7681, or $PORT
  --scrollback N lines of history a reconnecting viewer gets back
                 (default 500, or $MTTY_SCROLLBACK)
  --hostname NAME the name a proxy in front of this presents, e.g. the
                 Cloudflare or tailnet hostname (or $MTTY_HOSTNAME)

Loopback is the default because the tunnel reaches it from this machine. Use
--lan to reach it from a phone on the same wifi, which puts an unauthenticated
terminal on your network.

The server owns the program. Every viewer sees the same screen, and the
narrowest one decides the size, because this is meant to be read on a phone.
`attach` joins a server that is already running; it does not start one. To end
the session, exit the program or run `down`.

There is no --password: Safari does not send basic-auth on a WebSocket
handshake, so the page would load and the terminal would never connect. Use
`setup` and let Cloudflare Access do the login.

A page on any site you visit can open a WebSocket to this server, so sockets
are refused unless their Origin matches the address they connected to. Reaching
it by address needs nothing; reaching it by name needs that name in --hostname.
USAGE
}

die() { echo "mobile-tty: $*" >&2; exit 1; }
usage_error() { echo "mobile-tty: $*" >&2; exit 2; }

cmd=""

# Options can come either side of the command, and everything after the first
# thing that is neither is the program. Parsing in one pass in a fixed order
# made `mobile-tty --lan up` run a program called "up".
take_options() {
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --lan) bind=0.0.0.0; shift ;;
      --bind) [[ $# -ge 2 ]] || usage_error "--bind needs a value"; bind=$2; shift 2 ;;
      --port) [[ $# -ge 2 ]] || usage_error "--port needs a value"; port=$2; shift 2 ;;
      --scrollback) [[ $# -ge 2 ]] || usage_error "--scrollback needs a value"; scrollback=$2; shift 2 ;;
      --hostname) [[ $# -ge 2 ]] || usage_error "--hostname needs a value"; hostname=$2; shift 2 ;;
      -h|--help|help) usage; exit 0 ;;
      --) shift; break ;;
      -*) usage_error "unknown option $1" ;;
      serve|attach|up|tunnel|setup|down)
        [[ -z "$cmd" ]] || break        # a second one is the program's business
        cmd=$1; shift ;;
      *) break ;;
    esac
  done
  REST=("$@")
}

REST=()
take_options "$@"
set -- ${REST[@]+"${REST[@]}"}
[[ -n "$cmd" ]] || cmd=serve

# setup takes a hostname, not our options, but it should still hear the port so
# the tunnel it writes points at the right place.
[[ "$cmd" == setup ]] && exec env PORT="$port" scripts/cf-access.sh "$@"

# Empty unless a name was given, so the flag is absent rather than blank.
host_args=()
[[ -n "$hostname" ]] && host_args=(--hostname "$hostname")

case "$cmd" in
  serve)
    [[ $# -gt 0 ]] || set -- "${default_program[@]}"
    echo "serving http://$bind:$port"
    exec node server/cli.js --port "$port" --bind "$bind" \
      ${host_args[@]+"${host_args[@]}"} --scrollback "$scrollback" -- "$@"
    ;;
  attach)
    echo "Ctrl-] detaches and leaves it running. Ctrl-C goes through to the program."
    exec node -e "import('./server/attach.js').then(m => m.attach({ url: 'ws://127.0.0.1:$port/ws' }))"
    ;;
  up)
    [[ -f "$config" ]] || die "no $config — run: mobile-tty setup <hostname>"
    # The edge answers this whether or not the tunnel is running, so it can be
    # asked before starting. It is the only thing about this setup you cannot
    # see from this machine.
    host=$(sed -n 's/^ *- hostname: *//p' "$config" | head -1)
    probe=$(curl -s -o /dev/null -w '%{http_code} %{redirect_url}' --max-time 8 "https://$host/" 2>/dev/null || echo '000 ')
    case "${probe%% *}" in
      30*) [[ "${probe#* }" == *cloudflareaccess.com* ]] &&
             echo "$host is behind a login" ||
             echo "$host redirects somewhere that is not Access — check the application" ;;
      200) echo "WARNING: $host answers with no login in front of it" ;;
      *) echo "$host is not answering yet (${probe%% *})" ;;
    esac
    [[ $# -gt 0 ]] || set -- "${default_program[@]}"
    cloudflared tunnel --config "$config" run &
    tunnel=$!
    # Installed as soon as there is anything to clean up: an interrupt between
    # here and the server starting would otherwise leave the tunnel orphaned,
    # since nothing would be watching it yet. $server is unset until the next
    # line, so the trap has to tolerate that.
    trap 'kill ${tunnel:-} ${server:-} 2>/dev/null || true' EXIT INT TERM
    echo "serving http://$bind:$port"
    # Both in the background, then wait. Not exec, which would replace this
    # shell and take the trap with it; and not the server in the foreground
    # either, because bash defers signals until the foreground command returns
    # — so a TERM would sit unhandled and leave the tunnel behind.
    node server/cli.js --port "$port" --bind "$bind" \
      ${host_args[@]+"${host_args[@]}"} --scrollback "$scrollback" -- "$@" &
    server=$!
    status=0
    wait $server || status=$?
    [[ $status -eq 0 ]] || echo "mobile-tty: the server exited ($status); stopping the tunnel too" >&2
    exit $status
    ;;
  tunnel)
    [[ -f "$config" ]] || die "no $config — run: mobile-tty setup <hostname>"
    exec cloudflared tunnel --config "$config" run
    ;;
  down)
    # The server is found by its port, not by matching its argv. pgrep -f on a
    # command line is both too wide (it matches anything that happens to contain
    # the same string) and too narrow (it can miss a process whose argv is
    # presented differently), and it has killed its own caller before. The port
    # is ground truth: lsof reads the kernel's socket table.
    ended=""
    server_pid=$(lsof -nP -tiTCP:$port -sTCP:LISTEN 2>/dev/null | head -1 || true)
    if [[ -n "$server_pid" ]]; then
      kill "$server_pid" 2>/dev/null || true
      # Give the PTY and its program a beat to notice, then only claim it done
      # if it is actually gone.
      sleep 1
      if lsof -nP -tiTCP:$port -sTCP:LISTEN 2>/dev/null | grep -q .; then
        echo "mobile-tty: server on $port is still running" >&2
        ended="$ended server(unconfirmed)"
      else
        ended="$ended server"
      fi
    fi
    # The tunnel has no port of its own; it is the one started by this config.
    # Narrow enough that it does not sweep up an unrelated tunnel.
    kill_matching() {
      local pids
      pids=$(pgrep -f "cloudflared tunnel --config $config" 2>/dev/null || true)
      [[ -n "$pids" ]] || return 0
      # shellcheck disable=SC2086
      kill $pids 2>/dev/null || true
      ended="$ended tunnel"
    }
    kill_matching
    if [[ -n "$ended" ]]; then
      echo "ended:$ended"
      [[ "$ended" == *server* ]] && echo "the program is gone, and so is whatever it was holding"
    else
      echo "nothing was running"
    fi
    exit 0
    ;;
esac
